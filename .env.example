# Sao chép file này thành .env.local rồi điền giá trị thật.
# .env.local nằm trong .gitignore nên không bao giờ bị commit lên GitHub.

# Bật gửi email thật từ form liên hệ.
# Chưa điền thì form vẫn chạy — nó sẽ mở ứng dụng mail của người xem với nội
# dung điền sẵn. Xem src/app/api/contact/route.ts.
# Lấy khoá miễn phí ở https://resend.com (3.000 mail/tháng).
RESEND_API_KEY=
# Địa chỉ gửi đi. Phải là tên miền đã xác thực trong Resend.
# Chưa có tên miền riêng thì dùng onboarding@resend.dev để thử.
CONTACT_FROM_EMAIL=

# Token GitHub, không bắt buộc.
# Không có token: GitHub cho 60 request/giờ mỗi IP — đủ dùng vì kết quả đã
# được cache một giờ. Có token: 5.000 request/giờ.
# Tạo ở https://github.com/settings/tokens — CHỈ CẦN quyền đọc public repo,
# không tick thêm quyền nào khác.
GITHUB_TOKEN=
